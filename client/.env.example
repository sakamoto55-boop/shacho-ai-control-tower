# ============================================================
# AI社長室 Phase 8 — Google OAuth 共通環境変数
# ============================================================
# 使い方:
#   cp client/.env.example client/.env
#   # 各値を設定してください
#
# Vite フロントエンドでは VITE_ プレフィックスが必要です。
# ============================================================

# ── Google OAuth 共通 Client ID ──
# Gmail / Calendar / Drive / Sheets など、すべての Google サービスで共通使用。
# Google Cloud Console で OAuth 2.0 クライアント ID を発行してください。
# クライアントタイプ: Webアプリケーション または デスクトップ
#
# 参考: https://console.cloud.google.com/apis/credentials

VITE_GOOGLE_CLIENT_ID=

# OAuth コールバック URI（Google Cloud Console と同一にすること）
# 例: http://localhost:5173/  または  https://your-domain.com/
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/

# 使用スコープ（Phase 8: gmail.readonly + calendar.readonly + drive.readonly + spreadsheets.readonly）
# 書き込みスコープ（send / modify / calendar / drive 等）は追加禁止。
VITE_GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/spreadsheets.readonly

# ============================================================
# Google Sheets スプレッドシート ID（Phase 8）
# ============================================================
# 各スプレッドシートの ID を設定してください。
# スプレッドシート URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
#
# 書き込み禁止: セル更新・行追加・行削除・シート作成・シート削除は実装していません。
# ============================================================

# 売上スプレッドシート
VITE_GOOGLE_SHEETS_SALES_ID=

# 資金繰りスプレッドシート
VITE_GOOGLE_SHEETS_CASHFLOW_ID=

# 案件粗利スプレッドシート
VITE_GOOGLE_SHEETS_PROJECT_PROFIT_ID=

# 売掛金（未回収）スプレッドシート
VITE_GOOGLE_SHEETS_RECEIVABLE_ID=

# 買掛金（外注費）スプレッドシート
VITE_GOOGLE_SHEETS_PAYABLE_ID=

# ============================================================
# スコープ管理方針
# ============================================================
# Phase 5: gmail.readonly
# Phase 6: gmail.readonly + calendar.readonly
# Phase 7: + drive.readonly
# Phase 8: + spreadsheets.readonly（現在）
# 書き込みスコープは永久に使用しない。
# ============================================================

# ============================================================
# 注意事項
# ============================================================
# ・client_secret はフロントエンドに含めない（SPA では使用しない）。
#   本番運用では、バックエンド Proxy サーバー経由での
#   トークン交換を推奨します（Phase 9 以降で対応予定）。
# ・認証情報を Git にコミットしないでください。
# ・書き込みスコープ（send, modify, delete, updateCell 等）は追加禁止。
# ============================================================
