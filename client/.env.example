# ============================================================
# AI社長室 Phase 11 — Google OAuth（Gmail ReadOnly 本番接続）
# ============================================================
# 使い方:
#   cp client/.env.example client/.env
#   # 各値を設定してください
#
# Vite フロントエンドでは VITE_ プレフィックスが必要です。
#
# 【Phase 11 の本番接続対象】
#   ✅ Gmail（読み取り専用 / gmail.readonly のみ）
#   ⏳ Calendar / Drive / Sheets / LINE WORKS は本番接続しない（デモのまま）
# ============================================================

# ── Google OAuth Client ID ──
# Google Cloud Console で OAuth 2.0 クライアント ID を発行してください。
# クライアントタイプ: ウェブアプリケーション
#
# 参考: https://console.cloud.google.com/apis/credentials
# 詳細手順: docs/GOOGLE_OAUTH_SETUP.md

VITE_GOOGLE_CLIENT_ID=

# OAuth コールバック URI（Google Cloud Console と完全一致させること）
# ローカル: http://localhost:5173/
# 本番:     https://sakamoto55-boop.github.io/shacho-ai-control-tower/
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/

# 使用スコープ（Phase 11: gmail.readonly のみ）
# ⚠️ 書き込みスコープ（send / modify / compose）は永久に追加禁止。
# ⚠️ Phase 11 では calendar / drive / sheets も追加しない。
VITE_GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# ============================================================
# 【Phase 12 以降で使用予定 — 現時点では設定しない】
# ============================================================
# Calendar / Drive / Sheets を本番接続するフェーズで、上の VITE_GOOGLE_SCOPES に
# 追記し、以下のスプレッドシート ID を設定します。Phase 11 では空のままにします。
#
# VITE_GOOGLE_SHEETS_SALES_ID=
# VITE_GOOGLE_SHEETS_CASHFLOW_ID=
# VITE_GOOGLE_SHEETS_PROJECT_PROFIT_ID=
# VITE_GOOGLE_SHEETS_RECEIVABLE_ID=
# VITE_GOOGLE_SHEETS_PAYABLE_ID=

# ============================================================
# LINE WORKS（Phase 9 デモ）— 読み取り専用 / 通知受信のみ
# ============================================================
# 書き込み禁止：送信・返信・既読化・削除・ファイル送信・ユーザー追加禁止
# 重要：VITE_LINEWORKS_CLIENT_SECRET はフロントエンドに配置しない。
#         本番時はバックエンドProxy経由でトークン管理を行うこと。
# ============================================================

# LINE WORKS アプリの Client ID（Developer Console で発行）
VITE_LINEWORKS_CLIENT_ID=

# LINE WORKS ドメイン ID（管理コンソールで確認）
VITE_LINEWORKS_DOMAIN_ID=

# LINE WORKS Bot ID（通知受信用 Bot を作成後に設定）
VITE_LINEWORKS_BOT_ID=

# 通知受信対象のチャンネル ID（通知用グループチャンネル）
VITE_LINEWORKS_CHANNEL_ID=

# Client Secret — フロントエンドへの配置は禁止。本番はバックエンド管理。
# VITE_LINEWORKS_CLIENT_SECRET=  ← このファイルに記載しない

# ============================================================
# スコープ管理方針
# ============================================================
# Phase 5:  gmail.readonly（基盤構築・デモ）
# Phase 6:  + calendar.readonly（デモ）
# Phase 7:  + drive.readonly（デモ）
# Phase 8:  + spreadsheets.readonly（デモ）
# Phase 9:  + LINE WORKS通知読み取り（デモ）
# Phase 11: gmail.readonly のみ 本番接続（現在）← Calendar/Drive/Sheets は本番化しない
# 書き込みスコープは永久に使用しない。
# ============================================================

# ============================================================
# 注意事項
# ============================================================
# ・client_secret はフロントエンドに含めない（SPA では使用しない）。
#   本番運用では、バックエンド Proxy サーバー経由での
#   トークン交換を推奨します（Phase 9 以降で対応予定）。
# ・認証情報を Git にコミットしないでください。
# ・書き込みスコープ（send, modify, delete, updateCell 等）は追加禁止。
# ============================================================
