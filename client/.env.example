# ============================================================
# AI社長室 Phase 5 — Google OAuth 環境変数
# ============================================================
# 使い方:
#   cp client/.env.example client/.env
#   # 各値を設定してください
#
# Vite フロントエンドでは VITE_ プレフィックスが必要です。
# ============================================================

# ── Google OAuth (Gmail ReadOnly のみ) ──
# Google Cloud Console でプロジェクトを作成し、
# OAuth 2.0 クライアント ID を発行してください。
# クライアントタイプ: Webアプリケーション または デスクトップ
#
# 参考: https://console.cloud.google.com/apis/credentials

VITE_GMAIL_CLIENT_ID=
VITE_GMAIL_CLIENT_SECRET=

# OAuth コールバック URI（Google Cloud Console と同一にすること）
# 例: http://localhost:5173/  または  https://your-domain.com/
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/

# Gmail 読み取り専用スコープ（変更禁止）
VITE_GOOGLE_READONLY_SCOPE=https://www.googleapis.com/auth/gmail.readonly

# ============================================================
# 注意事項
# ============================================================
# ・VITE_GMAIL_CLIENT_SECRET はフロントエンドに露出します。
#   本番運用では、バックエンド Proxy サーバー経由での
#   トークン交換を推奨します（Phase 6 以降で対応予定）。
# ・認証情報を Git にコミットしないでください。
# ・書き込みスコープ（send, modify, delete 等）は追加禁止。
# ============================================================
