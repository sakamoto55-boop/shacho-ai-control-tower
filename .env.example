NODE_ENV=development
PORT=8787
ENABLE_DEV_ENDPOINTS=true

# Storage
STORAGE_DRIVER=local
LOCAL_DB_PATH=./data/shacho-ai-local.json

# AI provider. MVP defaults to mock.
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# kintone future connection. Leave blank for Phase 1 local MVP.
KINTONE_BASE_URL=
KINTONE_INBOX_APP_ID=
KINTONE_TASK_APP_ID=
KINTONE_REPLY_DRAFT_APP_ID=
KINTONE_API_TOKEN=

# Gmail future connection. Leave blank for Phase 1 local MVP.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_QUERY=

# Google OAuth Phase 5 (フロントエンド用 / client/.env.example 参照)
# VITE_GMAIL_CLIENT_ID=
# VITE_GMAIL_CLIENT_SECRET=
# VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/
# VITE_GOOGLE_READONLY_SCOPE=https://www.googleapis.com/auth/gmail.readonly

# LINE WORKS future connection. Leave blank for Phase 1 local MVP.
LINEWORKS_BOT_ID=
LINEWORKS_CLIENT_ID=
LINEWORKS_CLIENT_SECRET=
LINEWORKS_SERVICE_ACCOUNT=
LINEWORKS_PRIVATE_KEY=
LINEWORKS_REPORT_ROOM_ID=
LINEWORKS_WEBHOOK_SECRET=
LINEWORKS_DRY_RUN=true
