NODE_ENV=development
PORT=8787
ENABLE_DEV_ENDPOINTS=true

# Storage
STORAGE_DRIVER=local
LOCAL_DB_PATH=./data/shacho-ai-local.json

# AI provider. MVP defaults to mock.
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# kintone future connection. Leave blank for Phase 1 local MVP.
KINTONE_BASE_URL=
KINTONE_INBOX_APP_ID=
KINTONE_TASK_APP_ID=
KINTONE_REPLY_DRAFT_APP_ID=
KINTONE_API_TOKEN=

# Gmail connection. Fill in to enable real email fetching.
# GMAIL_USER_EMAIL is used to detect "unreplied" threads (emails where you are NOT the last sender).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_USER_EMAIL=
GMAIL_QUERY=

# Email alert automation
# SCHEDULER_ENABLED: set to true to start cron jobs (朝08:00 / 昼12:30 / 夕18:00 JST) inside server.ts
SCHEDULER_ENABLED=false
# ALERT_SAVE_PATH: directory where alert text files are saved
ALERT_SAVE_PATH=./data/alerts
# ALERT_SLOT: used by POST /jobs/email-alert when no slot is specified in request body
ALERT_SLOT=morning

# Notifications — set at least one to receive alerts outside the server log.
# Gmail: send alert email to yourself (reuses Gmail OAuth above)
# Set GMAIL_NOTIFY_TO to your email address. No extra credentials needed.
GMAIL_NOTIFY_TO=

# Slack Incoming Webhook (optional — leave blank if unused)
SLACK_WEBHOOK_URL=

# LINE WORKS future connection. Leave blank for Phase 1 local MVP.
LINEWORKS_BOT_ID=
LINEWORKS_CLIENT_ID=
LINEWORKS_CLIENT_SECRET=
LINEWORKS_SERVICE_ACCOUNT=
LINEWORKS_PRIVATE_KEY=
LINEWORKS_REPORT_ROOM_ID=
LINEWORKS_WEBHOOK_SECRET=
LINEWORKS_DRY_RUN=true
