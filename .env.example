NODE_ENV=development
PORT=8787
ENABLE_DEV_ENDPOINTS=true

# Storage
STORAGE_DRIVER=local
LOCAL_DB_PATH=./data/shacho-ai-local.json

# AI provider. MVP defaults to mock.
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# kintone future connection. Leave blank for Phase 1 local MVP.
KINTONE_BASE_URL=
KINTONE_INBOX_APP_ID=
KINTONE_TASK_APP_ID=
KINTONE_REPLY_DRAFT_APP_ID=
KINTONE_API_TOKEN=

# Gmail future connection. Leave blank for Phase 1 local MVP.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_QUERY=

# LINE WORKS future connection. Leave blank for Phase 1 local MVP.
LINEWORKS_BOT_ID=
LINEWORKS_CLIENT_ID=
LINEWORKS_CLIENT_SECRET=
LINEWORKS_SERVICE_ACCOUNT=
LINEWORKS_PRIVATE_KEY=
LINEWORKS_REPORT_ROOM_ID=
LINEWORKS_WEBHOOK_SECRET=
LINEWORKS_DRY_RUN=true

# claude.ai カスタムコネクタ用 MCP エンドポイント（LINE WORKS送信）
# LINEWORKS_MCP_TOKEN: 未設定なら /mcp は無効。長いランダム文字列を設定する（URLの一部になる）
# LINEWORKS_RECIPIENTS: 送信を許可する宛先のJSON配列。ここにない宛先へは送信できない
#   例: [{"name":"竹内","type":"user","id":"k.takeuchi@example.com"},{"name":"平良","type":"user","id":"taira@example.com"}]
LINEWORKS_MCP_TOKEN=
LINEWORKS_RECIPIENTS=
