NODE_ENV=production
PORT=8787
ENABLE_DEV_ENDPOINTS=false

# Storage
STORAGE_DRIVER=local
LOCAL_DB_PATH=./data/shacho-ai-local.json

# AI provider. MVP defaults to mock.
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# kintone future connection. Leave blank for Phase 1 local MVP.
KINTONE_BASE_URL=
KINTONE_INBOX_APP_ID=
KINTONE_TASK_APP_ID=
KINTONE_REPLY_DRAFT_APP_ID=
KINTONE_API_TOKEN=

# Gmail future connection. Leave blank for Phase 1 local MVP.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_QUERY=

# LINE WORKS future connection. Leave blank for Phase 1 local MVP.
LINEWORKS_BOT_ID=
LINEWORKS_CLIENT_ID=
LINEWORKS_CLIENT_SECRET=
LINEWORKS_SERVICE_ACCOUNT=
LINEWORKS_PRIVATE_KEY=
LINEWORKS_REPORT_ROOM_ID=
LINEWORKS_WEBHOOK_SECRET=
LINEWORKS_DRY_RUN=true

# ============================================================
# LCC COMMAND（会話型AI経営管制OS）
# ============================================================
# demo: Demo Fixture / production: 実データのみ（未接続はDATA UNAVAILABLE。デモへ戻らない）
LCC_COMMAND_MODE=production
LCC_COMMAND_DB_PATH=./data/lcc-command-local.json
# 静的トークン認証（Phase A方式）: {"<token>":{"role":"PRESIDENT","companyIds":["*"],"label":"社長"}}
LCC_COMMAND_API_TOKENS=
# Google Identity認証（設定時はIDトークン検証を優先。RBACは共通）
LCC_GOOGLE_AUDIENCE=
LCC_COMMAND_USERS=
# 法人マスタ: [{"companyId":"lcc","name":"株式会社LCC"}]
LCC_COMMAND_COMPANIES=
# Google Sheets READ ONLY接続（正本確定後に設定。SheetSourceConfig[]のJSON）
LCC_SHEETS_SOURCES=
# 本番標準: Service Account（spreadsheets.readonly固定・対象シートのみ閲覧者共有の最小権限）
# サービスアカウントJSONをインラインで貼るか、ファイルパスで指定する（Secretは.envのみ。Git禁止）
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
# 開発検証用の代替（本番の非公開業務シート認証にAPI Keyは使わない）
GOOGLE_SHEETS_ACCESS_TOKEN=
GOOGLE_SHEETS_API_KEY=
# 発見フェーズのスナップショット読込（クレデンシャル不要の検証経路）
LCC_SHEETS_SNAPSHOT_DIR=
# 監査ログのJSONL出力先（空ならメモリのみ）
LCC_COMMAND_AUDIT_FILE=
# Observability/コスト記録のJSONL出力先（会話本文は保存しない。空ならメモリのみ）
LCC_COMMAND_OBS_FILE=
# 夜間メンテナンス実適用（既定はDRY RUN。npm run command:maintenance）
LCC_MAINTENANCE_APPLY=false
LCC_COMMAND_RATE_LIMIT=60
# Phase M/LIVE-AI: 実LLM Provider（いずれか1つで実会話が有効化。未設定なら「できない」と正直に返す）
# ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY / MANUS_API_KEY はSecret（.envのみ・Git禁止）
LCC_COMMAND_MODEL=claude-sonnet-5
LCC_COMMAND_OPENAI_MODEL=gpt-5
LCC_COMMAND_GEMINI_MODEL=gemini-2.5-pro
LCC_COMMAND_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
MANUS_BASE_URL=
# 生成Artifactの保存先（Git管理外）
LCC_ARTIFACT_DIR=./data/artifacts
