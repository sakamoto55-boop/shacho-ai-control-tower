    "sync:board": "tsx scripts/sync-integrations.ts board",
    "sync:drive": "tsx scripts/sync-integrations.ts drive",
    "sync:freee": "tsx scripts/sync-integrations.ts freee",
    "sync:tkc": "tsx scripts/sync-integrations.ts tkc",
