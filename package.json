    "command:real-eval": "tsx scripts/real-evaluation.ts",
    "command:benchmark": "tsx scripts/provider-benchmark.ts",
    "command:growth": "tsx scripts/growth-observe.ts",
    "command:beta": "tsx scripts/beta-gate.ts",
